# ── EQUITY LEGAL – webkitty .htaccess ──

Options -Indexes
ServerSignature Off

# ── Character encoding ──
AddDefaultCharset UTF-8

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

# ── Browser caching ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png  "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
</IfModule>

# ── Security headers ──
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Protect data directory ──
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block direct access to data/*.json
  RewriteRule ^data/ - [F,L]

  # Block direct access to admin/includes/
  RewriteRule ^admin/includes/ - [F,L]

  # Friendly admin URLs
  RewriteRule ^prihlaseni/?$ admin/login.php [L]
  RewriteRule ^administrace/?$ admin/index.php [L]
  RewriteRule ^administrace/([a-zA-Z0-9_-]+)/?$ admin/$1.php [L,QSA]

  # Optional: clean URLs (remove .php)
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# ── Block PHP execution inside uploads folders ──
<IfModule mod_rewrite.c>
  RewriteRule ^assets/uploads/.*\.(php|php\d|phtml|phar)$ - [F,L]
</IfModule>
<Files "*.log">
  Require all denied
</Files>

# ── Default document ──
DirectoryIndex index.php index.html
