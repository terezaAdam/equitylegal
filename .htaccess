Options -Indexes
ServerSignature Off

AddDefaultCharset UTF-8

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png  "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://api.web3forms.com; object-src 'none'"
</IfModule>

# Block access to sensitive/hidden files regardless of directory
<FilesMatch "^\.(?!well-known)|\.(env|json|log|md|lock)$">
  Require all denied
</FilesMatch>
<Files "composer.json">
  Require all denied
</Files>
<Files "composer.lock">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block direct access to data/*.json
  RewriteRule ^data/ - [F,L]

  # Block direct access to admin/includes/
  RewriteRule ^admin/includes/ - [F,L]

  # Friendly admin URLs
  RewriteRule ^prihlaseni/?$ admin/login.php [L]
  RewriteRule ^administrace/?$ admin/index.php [L]
  RewriteRule ^administrace/([a-zA-Z0-9_-]+)/?$ admin/$1.php [L,QSA]

  # Canonical redirects: old .php URLs -> clean, translated slugs
  # Absolute https:// target avoids a redirect loop behind a CDN/load balancer
  # that terminates TLS before it reaches Apache (mod_rewrite can't see HTTPS
  # was used, so a scheme-relative target would fall back to http://).
  RewriteRule ^index\.php$ https://%{HTTP_HOST}/ [R=301,L]
  RewriteRule ^en/index\.php$ https://%{HTTP_HOST}/en/ [R=301,L]
  RewriteRule ^de/index\.php$ https://%{HTTP_HOST}/de/ [R=301,L]

  RewriteRule ^sluzby\.php$ https://%{HTTP_HOST}/sluzby [R=301,L]
  RewriteRule ^pripady\.php$ https://%{HTTP_HOST}/pripady [R=301,L]
  RewriteRule ^tym\.php$ https://%{HTTP_HOST}/tym [R=301,L]
  RewriteRule ^publikace\.php$ https://%{HTTP_HOST}/publikace [R=301,L]
  RewriteRule ^kontakty\.php$ https://%{HTTP_HOST}/kontakty [R=301,L]
  RewriteRule ^ochrana-osobnich-udaju\.php$ https://%{HTTP_HOST}/ochrana-osobnich-udaju [R=301,L]

  RewriteRule ^en/sluzby\.php$ https://%{HTTP_HOST}/en/services [R=301,L]
  RewriteRule ^en/pripady\.php$ https://%{HTTP_HOST}/en/blog [R=301,L]
  RewriteRule ^en/tym\.php$ https://%{HTTP_HOST}/en/team [R=301,L]
  RewriteRule ^en/publikace\.php$ https://%{HTTP_HOST}/en/publications [R=301,L]
  RewriteRule ^en/kontakty\.php$ https://%{HTTP_HOST}/en/contact [R=301,L]
  RewriteRule ^en/ochrana-osobnich-udaju\.php$ https://%{HTTP_HOST}/en/privacy-policy [R=301,L]

  RewriteRule ^de/sluzby\.php$ https://%{HTTP_HOST}/de/leistungen [R=301,L]
  RewriteRule ^de/pripady\.php$ https://%{HTTP_HOST}/de/blog [R=301,L]
  RewriteRule ^de/tym\.php$ https://%{HTTP_HOST}/de/team [R=301,L]
  RewriteRule ^de/publikace\.php$ https://%{HTTP_HOST}/de/publikationen [R=301,L]
  RewriteRule ^de/kontakty\.php$ https://%{HTTP_HOST}/de/kontakt [R=301,L]
  RewriteRule ^de/ochrana-osobnich-udaju\.php$ https://%{HTTP_HOST}/de/datenschutz [R=301,L]

  # Clean translated URLs -> actual files
  RewriteRule ^sluzby/?$ sluzby.php [L,QSA]
  RewriteRule ^pripady/?$ pripady.php [L,QSA]
  RewriteRule ^tym/?$ tym.php [L,QSA]
  RewriteRule ^publikace/?$ publikace.php [L,QSA]
  RewriteRule ^kontakty/?$ kontakty.php [L,QSA]
  RewriteRule ^ochrana-osobnich-udaju/?$ ochrana-osobnich-udaju.php [L,QSA]

  RewriteRule ^en/services/?$ sluzby.php [L,QSA]
  RewriteRule ^en/blog/?$ pripady.php [L,QSA]
  RewriteRule ^en/team/?$ tym.php [L,QSA]
  RewriteRule ^en/publications/?$ publikace.php [L,QSA]
  RewriteRule ^en/contact/?$ kontakty.php [L,QSA]
  RewriteRule ^en/privacy-policy/?$ ochrana-osobnich-udaju.php [L,QSA]

  RewriteRule ^de/leistungen/?$ sluzby.php [L,QSA]
  RewriteRule ^de/blog/?$ pripady.php [L,QSA]
  RewriteRule ^de/team/?$ tym.php [L,QSA]
  RewriteRule ^de/publikationen/?$ publikace.php [L,QSA]
  RewriteRule ^de/kontakt/?$ kontakty.php [L,QSA]
  RewriteRule ^de/datenschutz/?$ ochrana-osobnich-udaju.php [L,QSA]

  # Language mutation roots; any other .php file under /en/ or /de/ (e.g. clanek.php)
  # keeps working under its Czech filename as a legacy fallback.
  RewriteCond %{REQUEST_URI} !^/(en|de)/(assets|admin|data|download)/
  RewriteRule ^(en|de)/?$ index.php [L,QSA]
  RewriteRule ^(en|de)/([a-zA-Z0-9_-]+)\.php$ $2.php [L,QSA]
</IfModule>

# ── Block PHP execution inside uploads folders ──
<IfModule mod_rewrite.c>
  RewriteRule ^assets/uploads/.*\.(php|php\d|phtml|phar)$ - [F,L]
</IfModule>
<Files "*.log">
  Require all denied
</Files>

# ── Default document ──
DirectoryIndex index.php index.html
